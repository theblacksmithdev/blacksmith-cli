# CI for {{projectName}}
#
# Generated by Blacksmith. You own this file — customize as needed.
name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ci-$\{{ github.ref }}
  cancel-in-progress: true

jobs:
{{#if needsBackend}}
{{#if isExpress}}
  backend:
    name: Backend (vitest)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{backendPath}}

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: {{backendPath}}/package-lock.json

      - name: Install dependencies
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      # The test suite builds its database from schema.prisma, so the client
      # has to exist before vitest starts.
      - name: Generate Prisma client
        run: npx prisma generate

      - name: Run tests
        run: npm run test

      - name: Build
        run: npm run build
{{else}}
  backend:
    name: Backend (pytest)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{backendPath}}

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: {{backendPath}}/requirements.txt

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Check for missing migrations
        run: python manage.py makemigrations --check --dry-run
        env:
          DJANGO_SETTINGS_MODULE: config.settings.test

      - name: Run tests
        run: pytest --cov --cov-report=term-missing
{{/if}}
{{/if}}
{{#if needsFrontend}}
  frontend:
    name: Frontend (vitest)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{frontendPath}}

    steps:
      - uses: actions/checkout@v4
{{#if isFullstack}}
{{#if isExpress}}

      # src/api/generated/ is git-ignored, so the typed client is rebuilt from
      # the backend schema before the frontend is type-checked or built.
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: |
            {{backendPath}}/package-lock.json
            {{frontendPath}}/package-lock.json

      - name: Install backend dependencies
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi
        working-directory: {{backendPath}}

      # Exporting the schema imports the route modules, which need the
      # generated client. Explicit rather than relying on Prisma's postinstall,
      # which does not run under `npm ci --ignore-scripts`.
      - name: Generate Prisma client
        run: npx prisma generate
        working-directory: {{backendPath}}

      - name: Export OpenAPI schema
        run: npm run openapi -- ../{{frontendPath}}/{{schemaFile}}
        working-directory: {{backendPath}}
{{else}}

      # src/api/generated/ is git-ignored, so the typed client is rebuilt from
      # the Django schema before the frontend is type-checked or built.
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: {{backendPath}}/requirements.txt

      - name: Install backend dependencies
        run: pip install -r requirements.txt
        working-directory: {{backendPath}}

      - name: Export OpenAPI schema
        run: python manage.py spectacular --file ../{{frontendPath}}/{{schemaFile}}
        working-directory: {{backendPath}}
        env:
          DJANGO_SETTINGS_MODULE: config.settings.test

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: {{frontendPath}}/package-lock.json
{{/if}}
{{else}}

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: {{frontendPath}}/package-lock.json
{{/if}}

      - name: Install dependencies
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi
{{#if isFullstack}}

      - name: Generate API client
        run: npx openapi-ts --input {{schemaFile}} --output src/api/generated
{{/if}}

      - name: Run tests
        run: npm run test

      - name: Build
        run: npm run build
{{/if}}
