import { Link, type LinkProps } from '@chakra-ui/react'
import { Link as ReactRouterLink } from 'react-router-dom'

interface RouterLinkProps extends Omit<LinkProps, 'href' | 'asChild'> {
  to: string
}

/**
 * Chakra-styled text link that navigates client-side with React Router.
 */
export function RouterLink({ to, children, ...props }: RouterLinkProps) {
  return (
    <Link asChild {...props}>
      <ReactRouterLink to={to}>{children}</ReactRouterLink>
    </Link>
  )
}
