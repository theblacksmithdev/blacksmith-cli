import { Alert } from '@chakra-ui/react'

interface StatusAlertProps {
  message: string
  title?: string
  status?: 'error' | 'success' | 'info' | 'warning' | 'neutral'
}

/**
 * Inline status message — form errors, request failures, confirmations.
 */
export function StatusAlert({ message, title, status = 'error' }: StatusAlertProps) {
  return (
    <Alert.Root status={status} variant="subtle">
      <Alert.Indicator />
      <Alert.Content>
        {title && <Alert.Title>{title}</Alert.Title>}
        <Alert.Description>{message}</Alert.Description>
      </Alert.Content>
    </Alert.Root>
  )
}
