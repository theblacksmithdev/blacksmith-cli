/**
 * API Client Configuration
 *
 * Configures the @hey-api/client-fetch client with:
 * - Base URL from environment
 * - JWT auth interceptor
 * - CSRF token interceptor (for Django)
 * - 401 token refresh interceptor
 *
 * Generated by Blacksmith. You own this file — customize as needed.
 */

{{#if isFullstack}}
import { client } from './generated/client.gen'
{{else}}
import { createClient } from '@hey-api/client-fetch'
{{/if}}
import { API_URL } from '@/shared/utils/api-url'
import { clearTokens, getAccessToken, getRefreshToken, setTokens } from './token-storage'

/** Fired when the session can't be renewed; the auth adapter signs the user out. */
export const AUTH_EXPIRED_EVENT = 'auth:expired'

const REFRESH_PATH = '/api/auth/refresh/'

{{#if isFullstack}}
// Configure the client the generated hooks call, so every request they make
// carries the token. `blacksmith sync` regenerates client.gen.ts; this
// configuration is applied to it at startup, so it survives every sync.
client.setConfig({ baseUrl: API_URL })
{{else}}
// A frontend-only project may not have generated a client yet. Once it has,
// configure the one in ./generated/client.gen instead, as fullstack projects
// do: the generated hooks call that client, not this one.
export const client = createClient({
  baseUrl: API_URL,
})
{{/if}}

// Auth interceptor — attach JWT to every request
client.interceptors.request.use((request) => {
  const accessToken = getAccessToken()
  if (accessToken) {
    request.headers.set('Authorization', `Bearer ${accessToken}`)
  }
  return request
})

// CSRF interceptor — Django requires this for non-GET requests
client.interceptors.request.use((request) => {
  const csrfToken = document.cookie
    .split('; ')
    .find((row) => row.startsWith('csrftoken='))
    ?.split('=')[1]

  if (csrfToken) {
    request.headers.set('X-CSRFToken', csrfToken)
  }
  return request
})

// Token refresh — concurrent callers share one in-flight request
let refreshPromise: Promise<boolean> | null = null

async function requestNewTokens(): Promise<boolean> {
  const refresh = getRefreshToken()
  if (!refresh) return false

  try {
    const response = await fetch(`${API_URL}${REFRESH_PATH}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh }),
    })

    if (!response.ok) return false

    const data = await response.json()
    setTokens(data.access, data.refresh)
    return true
  } catch {
    return false
  }
}

/** Exchange the stored refresh token for a new pair. Resolves false if that fails. */
export function refreshAccessToken(): Promise<boolean> {
  refreshPromise ??= requestNewTokens().finally(() => {
    refreshPromise = null
  })
  return refreshPromise
}

// 401 interceptor — try to renew the session; sign out if that fails
client.interceptors.response.use(async (response) => {
  if (response.status === 401 && !response.url.includes(REFRESH_PATH)) {
    const refreshed = await refreshAccessToken()
    if (!refreshed) {
      clearTokens()
      window.dispatchEvent(new CustomEvent(AUTH_EXPIRED_EVENT))
    }
  }
  return response
})
