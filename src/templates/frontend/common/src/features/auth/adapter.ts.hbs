import type { ApiUser, AuthAdapter, AuthUser, AuthError, SocialProvider, TokenPair } from './types'
import { AUTH_EXPIRED_EVENT, refreshAccessToken } from '@/api/client'
import { clearTokens, getAccessToken, getRefreshToken, setTokens } from '@/api/token-storage'
import { parseApiError } from '@/shared/utils/api-error'
import { API_URL } from '@/shared/utils/api-url'

// Internal state
let currentUser: AuthUser | null = null
let authListeners: Array<(user: AuthUser | null) => void> = []
// False until the stored session has been checked, so guards don't redirect early
let initialized = false

function notifyListeners(user: AuthUser | null) {
  currentUser = user
  initialized = true
  authListeners.forEach((cb) => cb(user))
}

function toAuthUser(data: ApiUser): AuthUser {
  return {
    id: String(data.id),
    email: data.email,
    displayName: data.first_name
      ? `${data.first_name}${data.last_name ? ' ' + data.last_name : ''}`
      : null,
    photoURL: null,
    emailVerified: true,
    providerId: 'password',
  }
}

function toAuthError(error: unknown): AuthError {
  const parsed = parseApiError(error)

  // If there are field-level errors, include them in the message
  const fieldMessages = Object.entries(parsed.fieldErrors)
    .map(([field, msgs]) => `${field}: ${msgs.join(', ')}`)
    .join('. ')

  const message = fieldMessages
    ? `${parsed.message} ${fieldMessages}`
    : parsed.message

  return { code: `auth/${parsed.status || 'error'}`, message }
}

async function apiFetch<T = unknown>(path: string, options: RequestInit = {}): Promise<T> {
  const response = await fetch(`${API_URL}${path}`, {
    headers: {
      'Content-Type': 'application/json',
      ...(getAccessToken() ? { Authorization: `Bearer ${getAccessToken()}` } : {}),
    },
    ...options,
  })

  const data = await response.json().catch(() => null)

  if (!response.ok) {
    throw { status: response.status, error: data || { detail: response.statusText } }
  }

  return data as T
}

async function fetchCurrentUser(): Promise<AuthUser> {
  const data = await apiFetch<ApiUser>('/api/auth/me/')
  return toAuthUser(data)
}

/**
 * Rebuild the session from stored tokens after a page load. An expired
 * access token is renewed once with the refresh token before giving up.
 */
async function restoreSession(): Promise<AuthUser | null> {
  if (!getAccessToken() && !getRefreshToken()) return null

  try {
    return await fetchCurrentUser()
  } catch {
    if (await refreshAccessToken()) {
      return fetchCurrentUser()
    }
    throw new Error('Session expired')
  }
}

export function createAuthAdapter(): AuthAdapter {
  restoreSession()
    .then(notifyListeners)
    .catch(() => {
      clearTokens()
      notifyListeners(null)
    })

  // The API client gave up renewing the session mid-use
  window.addEventListener(AUTH_EXPIRED_EVENT, () => notifyListeners(null))

  return {
    async signInWithEmail(email: string, password: string) {
      try {
        const data = await apiFetch<TokenPair>('/api/auth/login/', {
          method: 'POST',
          body: JSON.stringify({ email, password }),
        })

        setTokens(data.access, data.refresh)
        const user = await fetchCurrentUser()
        notifyListeners(user)

        return { success: true, user }
      } catch (error: unknown) {
        return { success: false, error: toAuthError(error) }
      }
    },

    async signUpWithEmail(
      email: string,
      password: string,
      displayName?: string
    ) {
      try {
        const data = await apiFetch<TokenPair>('/api/auth/register/', {
          method: 'POST',
          body: JSON.stringify({
            email,
            password,
            password_confirm: password,
            first_name: displayName || '',
          }),
        })

        setTokens(data.access, data.refresh)
        const user = await fetchCurrentUser()
        notifyListeners(user)

        return { success: true, user }
      } catch (error: unknown) {
        return { success: false, error: toAuthError(error) }
      }
    },

    async signInWithSocial(provider: SocialProvider) {
      return {
        success: false,
        error: {
          code: 'auth/unsupported',
          message: `Signing in with ${provider} is not configured yet. Implement OAuth on the backend.`,
        },
      }
    },

    async sendPasswordResetEmail(email: string) {
      try {
        await apiFetch('/api/auth/forgot-password/', {
          method: 'POST',
          body: JSON.stringify({ email }),
        })
        return { success: true as const }
      } catch (error: unknown) {
        return { success: false as const, error: toAuthError(error) }
      }
    },

    async confirmPasswordReset(code: string, newPassword: string) {
      try {
        await apiFetch('/api/auth/reset-password/', {
          method: 'POST',
          body: JSON.stringify({
            token: code,
            password: newPassword,
            password_confirm: newPassword,
          }),
        })
        return { success: true as const }
      } catch (error: unknown) {
        return { success: false as const, error: toAuthError(error) }
      }
    },

    async signOut(): Promise<void> {
      try {
        // Lets the backend revoke the refresh token (Django blacklists it)
        await apiFetch('/api/auth/logout/', {
          method: 'POST',
          body: JSON.stringify({ refresh: getRefreshToken() }),
        })
      } catch {
        // Ignore errors on logout
      }
      clearTokens()
      notifyListeners(null)
    },

    getCurrentUser(): AuthUser | null {
      return currentUser
    },

    onAuthStateChanged(callback: (user: AuthUser | null) => void): () => void {
      authListeners.push(callback)
      // Fire immediately once the stored session has been checked
      if (initialized) callback(currentUser)

      return () => {
        authListeners = authListeners.filter((cb) => cb !== callback)
      }
    },
  }
}
