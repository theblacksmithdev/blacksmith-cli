import type { Router } from 'vue-router'
import { useAuthStore } from '@/features/auth/stores/auth-store'
import { Path } from './paths'

/**
 * Send signed-out visitors of a `requiresAuth` route to log in, and back to
 * the page they asked for afterwards.
 *
 * Waits for the stored session to be restored first: on a hard refresh of a
 * private page the user is not known yet, and redirecting then would sign
 * them out of every page they reload.
 */
export function installAuthGuard(router: Router) {
  router.beforeEach(async (to) => {
    if (!to.matched.some((record) => record.meta.requiresAuth)) return true

    const auth = useAuthStore()
    await auth.whenReady()
    if (auth.isAuthenticated) return true

    return { path: Path.Login, query: { redirect: to.fullPath } }
  })
}
