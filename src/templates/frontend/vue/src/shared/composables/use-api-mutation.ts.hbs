/**
 * useApiMutation — Enhanced useMutation for API calls
 *
 * Wraps TanStack useMutation with:
 * - DRF error parsing with field-level and general error messages
 * - Optional query invalidation after success
 *
 * Error state is derived from the mutation's own `error` — no local state.
 *
 * Usage:
 *   const createPost = useApiMutation({
 *     ...blogPostsCreateMutation(),
 *     invalidateKeys: [blogPostsListQueryKey()],
 *   })
 *
 *   // In a form submit handler:
 *   createPost.mutate({ body: { title: 'Hello' } })
 *
 *   // Display the general error message:
 *   <StatusAlert v-if="createPost.errorMessage.value" :message="createPost.errorMessage.value" />
 *
 *   // Access field errors for inline form display:
 *   createPost.fieldErrors.value.title  // ["This field is required."]
 *
 * Generated by Blacksmith. You own this file — customize as needed.
 */

import { computed, toValue, unref, type ComputedRef, type MaybeRefOrGetter, type Ref } from 'vue'
import {
  useMutation,
  useQueryClient,
  type QueryKey,
  type UseMutationOptions,
  type UseMutationReturnType,
} from '@tanstack/vue-query'
import { parseApiError, type ApiError } from '@/shared/utils/api-error'

/** Vue Query's options as a plain object (not a ref or getter): what the generated `*Mutation()` helpers return. */
type MutationOptionsObject<TData, TVariables, TOnMutateResult> = Exclude<
  UseMutationOptions<TData, Error, TVariables, TOnMutateResult>,
  Ref | ((...args: never[]) => unknown)
>

export type UseApiMutationOptions<TData, TVariables, TOnMutateResult> =
  MutationOptionsObject<TData, TVariables, TOnMutateResult> & {
    /** Query keys to invalidate after a successful mutation; a getter is read at that moment */
    invalidateKeys?: MaybeRefOrGetter<QueryKey[]>
  }

export type UseApiMutationResult<TData, TVariables, TOnMutateResult> =
  UseMutationReturnType<TData, Error, TVariables, TOnMutateResult> & {
    /** Parsed field-level errors from the last failed mutation (e.g. { email: ["Already exists."] }) */
    fieldErrors: ComputedRef<Record<string, string[]>>
    /** Parsed API error from the last failed mutation */
    apiError: ComputedRef<ApiError | null>
    /** Single error message string from the last failed mutation */
    errorMessage: ComputedRef<string | null>
  }

export function useApiMutation<
  TData = unknown,
  TVariables = void,
  TOnMutateResult = unknown,
>(
  options: UseApiMutationOptions<TData, TVariables, TOnMutateResult>,
): UseApiMutationResult<TData, TVariables, TOnMutateResult> {
  const queryClient = useQueryClient()

  const { invalidateKeys, ...mutationOptions } = options

  const mutation = useMutation<TData, Error, TVariables, TOnMutateResult>({
    ...mutationOptions,
    onSuccess: (...args) => {
      for (const key of toValue(invalidateKeys) ?? []) {
        queryClient.invalidateQueries({ queryKey: key })
      }
      return unref(mutationOptions.onSuccess)?.(...args)
    },
  })

  const apiError = computed(() => (mutation.error.value ? parseApiError(mutation.error.value) : null))

  return {
    ...mutation,
    fieldErrors: computed(() => apiError.value?.fieldErrors ?? {}),
    apiError,
    errorMessage: computed(() => apiError.value?.message ?? null),
  }
}
