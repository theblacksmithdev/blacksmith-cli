/**
 * useApiQuery — Enhanced useQuery for API calls
 *
 * Wraps TanStack useQuery with:
 * - Smart retry (skips 401, 403, 404)
 * - Parsed error messages from DRF responses
 * - Typed error state
 *
 * Pass the options as a getter when they depend on reactive state, so the
 * query refetches when that state changes:
 *
 *   const page = ref(1)
 *   const { data, errorMessage } = useApiQuery(() => ({
 *     ...blogPostsListOptions({ query: { page: page.value } }),
 *   }))
 *
 * Generated by Blacksmith. You own this file — customize as needed.
 */

import { computed, toValue, type ComputedRef, type MaybeRefOrGetter } from 'vue'
import {
  useQuery,
  type QueryKey,
  type UseQueryOptions,
  type UseQueryReturnType,
} from '@tanstack/vue-query'
import { parseApiError, shouldRetryRequest, type ApiError } from '@/shared/utils/api-error'

export type UseApiQueryResult<TData> = UseQueryReturnType<TData, Error> & {
  errorMessage: ComputedRef<string | null>
  apiError: ComputedRef<ApiError | null>
}

export function useApiQuery<
  TQueryFnData = unknown,
  TData = TQueryFnData,
  TQueryKey extends QueryKey = QueryKey,
>(
  options: MaybeRefOrGetter<UseQueryOptions<TQueryFnData, Error, TData, TQueryFnData, TQueryKey>>,
): UseApiQueryResult<TData> {
  const query = useQuery<TQueryFnData, Error, TData, TQueryKey>(
    computed(() => ({
      retry: shouldRetryRequest,
      ...toValue(options),
    })),
  )

  const apiError = computed(() => (query.error.value ? parseApiError(query.error.value) : null))

  return {
    ...query,
    errorMessage: computed(() => apiError.value?.message ?? null),
    apiError,
  }
}
