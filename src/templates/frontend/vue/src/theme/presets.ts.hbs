/**
 * Theme Presets
 *
 * The preset chosen at `blacksmith init` decides the accent colour and the
 * corner style. Change `activePreset` to switch the whole UI in one place,
 * then restart `blacksmith dev`: the Nuxt UI plugin reads it at startup.
 * Generated by Blacksmith. You own this file — customize as needed.
 */

export type ThemePreset = 'default' | 'neutral' | 'blue' | 'green' | 'red' | 'violet'

/** `mono` is hand-tuned in main.css; anything else is one of Tailwind's palettes. */
export type AccentColor = 'mono' | 'blue' | 'green' | 'red' | 'violet'

interface PresetConfig {
  /** `mono` is the black-and-white OpenAI look; the rest tint actions with a colour. */
  accent: AccentColor
  /** Pill buttons and soft corners, or square edges throughout. */
  rounded: boolean
}

export const PRESETS: Record<ThemePreset, PresetConfig> = {
  default: { accent: 'mono', rounded: true },
  neutral: { accent: 'mono', rounded: false },
  blue: { accent: 'blue', rounded: true },
  green: { accent: 'green', rounded: true },
  red: { accent: 'red', rounded: true },
  violet: { accent: 'violet', rounded: true },
}

export const activePreset = PRESETS['{{themePreset}}']
