 */

import { computed, ref } from 'vue'
import { defineStore } from 'pinia'
import { createAuthAdapter } from '../adapter'
import type { AuthError, AuthUser } from '../types'

export const useAuthStore = defineStore('auth', () => {
  const adapter = createAuthAdapter()

  const user = ref<AuthUser | null>(adapter.getCurrentUser())
  const loading = ref(true)
  const error = ref<AuthError | null>(null)

  // Settles once the stored session has been checked, so guards don't redirect early
  const ready = new Promise<void>((resolve) => {
    adapter.onAuthStateChanged((u) => {
      user.value = u
      loading.value = false
      resolve()
    })
  })

  const isAuthenticated = computed(() => !!user.value)

  /** Run an adapter action, recording its error for the page to show. */
  async function track<T extends { success: boolean; error?: AuthError }>(action: () => Promise<T>) {
    error.value = null
    const result = await action()
    if (!result.success && result.error) {
      error.value = result.error
    }
    return result
  }

  function whenReady() {
    return ready
  }

  function signInWithEmail(email: string, password: string) {
    return track(() => adapter.signInWithEmail(email, password))
  }

  function signUpWithEmail(email: string, password: string, displayName?: string) {
    return track(() => adapter.signUpWithEmail(email, password, displayName))
  }

  function sendPasswordResetEmail(email: string) {
    return track(() => adapter.sendPasswordResetEmail(email))
  }

  function confirmPasswordReset(code: string, newPassword: string) {
    return track(() => adapter.confirmPasswordReset(code, newPassword))
  }

  async function signOut() {
    error.value = null
    await adapter.signOut()
  }

  return {
    user,
    loading,
    error,
    isAuthenticated,
    whenReady,
    signInWithEmail,
    signUpWithEmail,
    sendPasswordResetEmail,
    confirmPasswordReset,
    signOut,
  }
})
