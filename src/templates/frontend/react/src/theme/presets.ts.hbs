import type { ColorPalette } from '@chakra-ui/react'

export type ThemePreset = 'default' | 'neutral' | 'blue' | 'green' | 'red' | 'violet'

/** `mono` is hand-tuned; anything else must be one of Chakra's built-in palettes. */
export type AccentPalette = 'mono' | Extract<ColorPalette, 'blue' | 'green' | 'red' | 'purple'>

interface PresetConfig {
  /** `mono` is the black-and-white OpenAI look; the rest tint actions with a color. */
  accent: AccentPalette
  /** Pill buttons and soft corners, or square edges throughout. */
  rounded: boolean
}

export const PRESETS: Record<ThemePreset, PresetConfig> = {
  default: { accent: 'mono', rounded: true },
  neutral: { accent: 'mono', rounded: false },
  blue: { accent: 'blue', rounded: true },
  green: { accent: 'green', rounded: true },
  red: { accent: 'red', rounded: true },
  violet: { accent: 'purple', rounded: true },
}

export const activePreset = PRESETS['{{themePreset}}']
