import { defineSemanticTokens } from '@chakra-ui/react'
import { activePreset } from './presets'
import { brandPalette } from './brand-palette'

const radii = activePreset.rounded
  ? { l1: '6px', l2: '10px', l3: '16px', control: '9999px' }
  : { l1: '0', l2: '0', l3: '0', control: '0' }

/**
 * Semantic tokens — what components actually reference. Every value has a
 * light and dark variant, so color mode switching is free.
 */
export const semanticTokens = defineSemanticTokens({
  colors: {
    bg: {
      DEFAULT: { value: { _light: '{colors.white}', _dark: '{colors.black}' } },
      subtle: { value: { _light: '{colors.gray.50}', _dark: '{colors.gray.950}' } },
      muted: { value: { _light: '{colors.gray.100}', _dark: '{colors.gray.900}' } },
      emphasized: { value: { _light: '{colors.gray.200}', _dark: '{colors.gray.800}' } },
      panel: { value: { _light: '{colors.white}', _dark: '{colors.gray.950}' } },
    },
    fg: {
      DEFAULT: { value: { _light: '{colors.black}', _dark: '{colors.gray.200}' } },
      muted: { value: { _light: '#5d5d5d', _dark: '{colors.gray.500}' } },
      subtle: { value: { _light: '#8f8f8f', _dark: '{colors.gray.600}' } },
    },
    border: {
      DEFAULT: { value: { _light: 'rgba(13, 13, 13, 0.08)', _dark: 'rgba(255, 255, 255, 0.08)' } },
      muted: { value: { _light: 'rgba(13, 13, 13, 0.05)', _dark: 'rgba(255, 255, 255, 0.05)' } },
      subtle: { value: { _light: 'rgba(13, 13, 13, 0.03)', _dark: 'rgba(255, 255, 255, 0.03)' } },
      emphasized: { value: { _light: 'rgba(13, 13, 13, 0.15)', _dark: 'rgba(255, 255, 255, 0.15)' } },
    },
    brand: brandPalette(activePreset.accent),
  },
  radii: {
    l1: { value: radii.l1 },
    l2: { value: radii.l2 },
    l3: { value: radii.l3 },
    /** Buttons, inputs and badges — pills by default. */
    control: { value: radii.control },
  },
  shadows: {
    panel: {
      value: {
        _light: '0 1px 2px rgba(13, 13, 13, 0.04), 0 8px 24px rgba(13, 13, 13, 0.04)',
        _dark: '0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.3)',
      },
    },
  },
})
