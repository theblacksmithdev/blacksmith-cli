import { Center, Spinner, type CenterProps } from '@chakra-ui/react'

interface LoadingSpinnerProps extends CenterProps {
  size?: 'sm' | 'md' | 'lg'
}

export function LoadingSpinner({ size = 'md', ...props }: LoadingSpinnerProps) {
  return (
    <Center {...props}>
      <Spinner size={size} color="fg.muted" />
    </Center>
  )
}
