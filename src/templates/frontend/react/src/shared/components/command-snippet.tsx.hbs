import { Code, HStack, Icon } from '@chakra-ui/react'
import { Terminal } from 'lucide-react'

interface CommandSnippetProps {
  command: string
}

/**
 * A terminal command shown as a quiet monospace pill.
 */
export function CommandSnippet({ command }: CommandSnippetProps) {
  return (
    <HStack
      gap="2"
      px="3"
      py="2"
      borderRadius="control"
      bg="bg.muted"
      color="fg.muted"
      w="fit-content"
      maxW="full"
      overflowX="auto"
    >
      <Icon boxSize="3.5" flexShrink="0">
        <Terminal />
      </Icon>
      <Code variant="plain" bg="transparent" color="fg" fontSize="xs" whiteSpace="nowrap">
        {command}
      </Code>
    </HStack>
  )
}
