import { useState } from 'react'
import { Button, Field, Input, Stack } from '@chakra-ui/react'
import { useNavigate, useParams } from 'react-router-dom'
import { useAuth } from '../hooks/use-auth'
import { AuthPanel } from '../components/auth-panel'
import { Path } from '@/router/paths'
import { RouterLink } from '@/shared/components/ui/router-link'

export default function ResetPasswordPage() {
  const navigate = useNavigate()
  const { token } = useParams<{ token: string }>()
  const { confirmPasswordReset, error } = useAuth()

  const [password, setPassword] = useState('')
  const [loading, setLoading] = useState(false)

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    setLoading(true)
    try {
      const result = await confirmPasswordReset(token || '', password)
      if (result.success) {
        navigate(Path.Login, { replace: true })
      }
    } finally {
      setLoading(false)
    }
  }

  return (
    <AuthPanel
      title="Choose a new password"
      description="Enter your new password below."
      error={error?.message}
      footer={
        <RouterLink to={Path.Login} color="fg" fontWeight="medium">
          Back to log in
        </RouterLink>
      }
    >
      <form onSubmit={handleSubmit}>
        <Stack gap="4">
          <Field.Root required>
            <Field.Label>New password</Field.Label>
            <Input
              type="password"
              autoComplete="new-password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              placeholder="Choose a new password"
            />
          </Field.Root>

          <Button type="submit" size="lg" w="full" mt="2" loading={loading}>
            Reset password
          </Button>
        </Stack>
      </form>
    </AuthPanel>
  )
}
