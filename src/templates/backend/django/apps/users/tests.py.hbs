class TestRegister:
    def test_returns_tokens(self, api_client, registration_payload, db):
        response = api_client.post(REGISTER_URL, registration_payload)

        assert response.status_code == status.HTTP_201_CREATED
        assert 'access' in response.data
        assert 'refresh' in response.data

    def test_creates_the_user(self, api_client, registration_payload, django_user_model, db):
        api_client.post(REGISTER_URL, registration_payload)

        assert django_user_model.objects.filter(email='new@example.com').exists()

    def test_rejects_mismatched_passwords(self, api_client, registration_payload, db):
        registration_payload['password_confirm'] = 'SomethingElse123!'

        response = api_client.post(REGISTER_URL, registration_payload)

        assert response.status_code == status.HTTP_400_BAD_REQUEST
        assert 'password_confirm' in response.data

    def test_rejects_duplicate_email(self, api_client, registration_payload, user, db):
        registration_payload['email'] = user.email

        response = api_client.post(REGISTER_URL, registration_payload)

        assert response.status_code == status.HTTP_400_BAD_REQUEST
        assert 'email' in response.data


