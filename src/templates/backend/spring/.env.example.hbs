# Copy to .env for local development. Never commit .env.
# At least 32 bytes: the tokens are signed with HMAC-SHA256.
SECRET_KEY=change-me-in-production-use-at-least-32-bytes
# Defaults to an H2 file database in data/. For Postgres:
# DATABASE_URL=jdbc:postgresql://localhost:5432/app?user=app&password=secret
# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:{{frontendPort}}
