package app.config;

import com.fasterxml.jackson.databind.PropertyNamingStrategies;
import io.swagger.v3.core.jackson.ModelResolver;
import io.swagger.v3.core.util.Json;
import io.swagger.v3.oas.models.Components;
import io.swagger.v3.oas.models.OpenAPI;
import io.swagger.v3.oas.models.info.Info;
import io.swagger.v3.oas.models.security.SecurityRequirement;
import io.swagger.v3.oas.models.security.SecurityScheme;
import org.springframework.boot.web.servlet.FilterRegistrationBean;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.Ordered;
import org.springframework.web.filter.UrlHandlerFilter;

/**
 * The OpenAPI document, served at /api/schema/ and exported by
 * {@code ./gradlew exportOpenApi}. The frontend client is generated from it.
 */
@Configuration
public class OpenApiConfig {

    @Bean
    OpenAPI openApi() {
        return new OpenAPI()
                .info(new Info()
                        .title("{{projectName}} API")
                        .version("0.1.0")
                        .description("API documentation for {{projectName}}. Generated by Blacksmith."))
                .components(new Components().addSecuritySchemes("jwtAuth", new SecurityScheme()
                        .type(SecurityScheme.Type.HTTP)
                        .scheme("bearer")
                        .bearerFormat("JWT")))
                .addSecurityItem(new SecurityRequirement().addList("jwtAuth"));
    }

    /**
     * Serve the document at /api/schema/ as well, the URL every Blacksmith backend
     * uses. springdoc maps it without the slash (application.yml), and this strips
     * the slash before the request reaches Spring Security or the mapping.
     */
    @Bean
    FilterRegistrationBean<UrlHandlerFilter> schemaTrailingSlash() {
        var registration = new FilterRegistrationBean<>(
                UrlHandlerFilter.trailingSlashHandler("/api/schema/").wrapRequest().build());
        registration.setOrder(Ordered.HIGHEST_PRECEDENCE);
        return registration;
    }

    /**
     * Document properties in snake_case, as the API sends them
     * ({@code spring.jackson.property-naming-strategy}). The document generator
     * keeps its own JSON mapper, which does not read that setting.
     */
    @Bean
    ModelResolver snakeCaseModelResolver() {
        return new ModelResolver(Json.mapper().copy().setPropertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE));
    }
}
