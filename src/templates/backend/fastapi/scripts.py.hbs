import json
import sys

from app.main import app


def main() -> None:
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    command = sys.argv[1]
    if command == "export-openapi":
        if len(sys.argv) < 3:
            print("usage: python scripts.py export-openapi <output.json>")
            sys.exit(1)
        with open(sys.argv[2], "w", encoding="utf-8") as f:
            json.dump(app.openapi(), f, indent=2)
        print(f"OpenAPI schema written to {sys.argv[2]}")
    else:
        print(f"Unknown command: {command}")
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
