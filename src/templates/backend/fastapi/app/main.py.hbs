"""FastAPI application entry point.

The OpenAPI document is served at `/api/schema/`, Swagger UI at `/api/docs/`
and ReDoc at `/api/redoc/` — the same URLs the Django and Express backends
use, so `blacksmith sync` and the frontend client work unchanged.

Generated by Blacksmith. You own this file — customize as needed.
"""

from contextlib import asynccontextmanager

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from app.config import settings
from app.db import init_db
from app.routers import auth


@asynccontextmanager
async def lifespan(app: FastAPI):
    # Every router — and therefore every model — is imported by this point,
    # so create_all sees the complete schema.
    init_db()
    yield


app = FastAPI(
    title="{{projectName}} API",
    version="0.1.0",
    lifespan=lifespan,
    openapi_url="/api/schema/",
    docs_url="/api/docs/",
    redoc_url="/api/redoc/",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.cors_origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

app.include_router(auth.router, prefix="/api/auth", tags=["auth"])

