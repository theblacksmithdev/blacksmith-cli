def signed_in_client() -> TestClient:
    """A client authenticated as a newly registered user."""
    client = TestClient(app)
    response = client.post(
        "/api/auth/register/",
        json={"email": f"{uuid.uuid4().hex}@example.com", "password": "secret123"},
    )
    assert response.status_code == 201, response.text
    client.headers["Authorization"] = f"Bearer {response.json()['access']}"
    return client


