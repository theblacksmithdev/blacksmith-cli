import type { User } from '@prisma/client'
import { prisma } from '../../db/client.js'
import { ApiError } from '../../utils/errors.js'
import { hashPassword, verifyPassword } from '../../utils/password.js'
import { issueTokens, verifyToken, type TokenPair } from '../../utils/tokens.js'
import type {
  ChangePasswordInput,
  LoginInput,
  PatchedUserInput,
  RegisterInput,
  UserOutput,
} from './auth.schemas.js'

/** Public shape of a user — never includes the password hash. */
export function serializeUser(user: User): UserOutput {
  return {
    id: user.id,
    email: user.email,
    first_name: user.first_name,
    last_name: user.last_name,
    date_joined: user.date_joined.toISOString(),
  }
}

export async function login({ email, password }: LoginInput): Promise<TokenPair> {
  const user = await prisma.user.findUnique({ where: { email } })

  // Verify against a real hash either way, so a missing account and a wrong
  // password take the same time and cannot be told apart by timing.
  const valid = user
    ? await verifyPassword(password, user.password)
    : await verifyPassword(password, await hashPassword('never-matches'))

  if (!user || !valid) {
    throw ApiError.nonField('Invalid email or password.')
  }
  if (!user.is_active) {
    throw ApiError.nonField('User account is disabled.')
  }

  return issueTokens(user.id)
}

export async function register(input: RegisterInput): Promise<TokenPair> {
  const existing = await prisma.user.findUnique({ where: { email: input.email } })
  if (existing) {
    throw ApiError.validation({
      email: ['A user with this email address already exists.'],
    })
  }

  const user = await prisma.user.create({
    data: {
      email: input.email,
      first_name: input.first_name,
      last_name: input.last_name,
      password: await hashPassword(input.password),
    },
  })

  return issueTokens(user.id)
}

export async function updateProfile(
  user: User,
  input: PatchedUserInput
): Promise<UserOutput> {
  const updated = await prisma.user.update({
    where: { id: user.id },
    data: input,
  })
  return serializeUser(updated)
}

export async function changePassword(
  user: User,
  input: ChangePasswordInput
): Promise<void> {
  const valid = await verifyPassword(input.old_password, user.password)
  if (!valid) {
    throw ApiError.validation({
      old_password: ['Current password is incorrect.'],
    })
  }

  await prisma.user.update({
    where: { id: user.id },
    data: { password: await hashPassword(input.new_password) },
  })
}

export function refreshTokens(refresh: string): TokenPair {
  const { user_id } = verifyToken(refresh, 'refresh')
  // ROTATE_REFRESH_TOKENS is on for the Django backend, so both tokens are
  // reissued here too and the client always stores the newest pair.
  return issueTokens(user_id)
}
