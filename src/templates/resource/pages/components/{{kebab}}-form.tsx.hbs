import { Button, Field, Input, Stack, Textarea } from '@chakra-ui/react'
import { StatusAlert } from '@/shared/components/status-alert'

const {{name}}Schema = z.object({
  title: z.string().min(1, 'Title is required').max(255),
  description: z.string().optional(),
})

type {{Name}}FormData = z.infer<typeof {{name}}Schema>

interface {{Name}}FormProps {
  defaultValues?: Partial<{{Name}}FormData>
  onSubmit: (data: {{Name}}FormData) => void | Promise<void>
  isSubmitting?: boolean
  /** General error message (e.g. from useApiMutation's errorMessage) */
  errorMessage?: string | null
  /** Server-side field errors (e.g. from useApiMutation's fieldErrors) */
  fieldErrors?: Record<string, string[]>
}

export function {{Name}}Form({
  defaultValues,
  onSubmit,
  isSubmitting,
  errorMessage,
  fieldErrors = {},
}: {{Name}}FormProps) {
  const form = useForm<{{Name}}FormData>({
    resolver: zodResolver({{name}}Schema),
    defaultValues: {
      title: '',
      description: '',
      ...defaultValues,
    },
  })

  const getFieldError = (field: keyof {{Name}}FormData): string | undefined => {
    // Client-side errors take priority, then server-side errors
    return form.formState.errors[field]?.message ?? fieldErrors[field]?.[0]
  }

  return (
    <form onSubmit={form.handleSubmit(onSubmit)}>
      <Stack gap="5">
        {errorMessage && <StatusAlert message={errorMessage} />}

        <Field.Root required invalid={!!getFieldError('title')}>
          <Field.Label>Title</Field.Label>
          <Input {...form.register('title')} />
          <Field.ErrorText>{getFieldError('title')}</Field.ErrorText>
        </Field.Root>

        <Field.Root invalid={!!getFieldError('description')}>
          <Field.Label>Description</Field.Label>
          <Textarea {...form.register('description')} rows={4} />
          <Field.ErrorText>{getFieldError('description')}</Field.ErrorText>
        </Field.Root>

        <Button type="submit" alignSelf="start" loading={isSubmitting} loadingText="Saving...">
