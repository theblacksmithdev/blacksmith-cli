/**
 * {{Name}} Detail Page
 *
 * Shows a single {{name}} with error handling.
 * Generated by Blacksmith. You own this file — customize as needed.
 */

import { useParams, useNavigate } from 'react-router-dom'
import { Button, Card, HStack, Skeleton, SkeletonText, Stack, Text } from '@chakra-ui/react'
import { useGet{{Name}}, useDelete{{Name}} } from '@/api/hooks/{{kebabs}}'
import { Path } from '@/router/paths'
import { PageHeader } from '@/shared/components/page-header'
import { StatusAlert } from '@/shared/components/status-alert'

export default function {{Name}}DetailPage() {
  const { id } = useParams<{ id: string }>()
  const navigate = useNavigate()
  const delete{{Name}} = useDelete{{Name}}()

  const { data: {{name}}, isLoading, errorMessage } = useGet{{Name}}(id!)

  if (isLoading) {
    return (
      <Stack gap="6" role="status" aria-label="Loading {{name}}">
        <Skeleton h="10" w="64" />
        <SkeletonText noOfLines={3} />
      </Stack>
    )
  }

  if (errorMessage) {
    return <StatusAlert message={errorMessage} />
  }

  if (!{{name}}) {
    return <Text color="fg.muted">{{Name}} not found.</Text>
  }

  const handleDelete = async () => {
    if (window.confirm('Are you sure you want to delete this {{name}}?')) {
      await delete{{Name}}.mutateAsync({ path: { id: id! } })
      navigate(Path.{{Names}})
    }
  }

  return (
    <Stack gap="8">
      {delete{{Name}}.errorMessage && <StatusAlert message={delete{{Name}}.errorMessage} />}

      <PageHeader
        title={({{name}} as any).title}
        actions={
          <HStack gap="2">
            <Button variant="outline" size="sm" onClick={() => navigate(`${Path.{{Names}}}/${id}/edit`)}>
              Edit
            </Button>
            <Button
              variant="outline"
              size="sm"
              colorPalette="red"
              onClick={handleDelete}
              loading={delete{{Name}}.isPending}
              loadingText="Deleting..."
            >
              Delete
            </Button>
          </HStack>
        }
      />

      <Card.Root variant="outline">
        <Card.Body gap="4">
          <Text whiteSpace="pre-wrap">
            {({{name}} as any).description || 'No description.'}
          </Text>
          <Text textStyle="sm" color="fg.muted">
            Created {new Date(({{name}} as any).created_at).toLocaleString()}
          </Text>
        </Card.Body>
      </Card.Root>
    </Stack>
  )
}
