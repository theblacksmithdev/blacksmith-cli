    private ResultActions send(MockHttpServletRequestBuilder request, String auth) throws Exception {
        return api.perform(request.header(HttpHeaders.AUTHORIZATION, auth));
    }

    private ResultActions sendJson(MockHttpServletRequestBuilder request, String auth, String json) throws Exception {
        return send(request.contentType(MediaType.APPLICATION_JSON).content(json), auth);
    }

    /** Creates a {{name}} as {@code auth} and returns its detail URL. */
    private String create{{Name}}(String auth, String title, String description) throws Exception {
        String body = sendJson(post(LIST_URL), auth, """
                {"title": "%s", "description": "%s"}
                """.formatted(title, description))
                .andExpect(status().isCreated())
                .andReturn().getResponse().getContentAsString();
        return LIST_URL + JsonPath.read(body, "$.id") + "/";
    }

    private String create{{Name}}(String auth) throws Exception {
        return create{{Name}}(auth, "Test {{Name}}", "A test {{name}}.");
    }

    @Nested
    class Create {

        @Test
        void createsA{{Name}}OwnedByTheCurrentUser() throws Exception {
            String email = JsonPath.read(send(get("/api/auth/me/"), me)
                    .andReturn().getResponse().getContentAsString(), "$.email");

            sendJson(post(LIST_URL), me, """
                    {"title": "New {{Name}}", "description": "Created in a test."}
                    """)
                    .andExpect(status().isCreated())
                    .andExpect(jsonPath("$.title").value("New {{Name}}"))
                    .andExpect(jsonPath("$.created_by_email").value(email));
        }

        @Test
        void requiresATitle() throws Exception {
            sendJson(post(LIST_URL), me, """
                    {"description": "No title."}
                    """)
                    .andExpect(status().isBadRequest())
                    .andExpect(jsonPath("$.title", contains("This field is required.")));
        }

        @Test
        void rejectsABlankTitle() throws Exception {
            sendJson(post(LIST_URL), me, """
                    {"title": ""}
                    """)
                    .andExpect(status().isBadRequest())
                    .andExpect(jsonPath("$.title", contains("This field may not be blank.")));
        }

        @Test
        void rejectsATitleOverTheLimit() throws Exception {
            sendJson(post(LIST_URL), me, """
                    {"title": "%s"}
                    """.formatted("x".repeat(256)))
                    .andExpect(status().isBadRequest())
                    .andExpect(jsonPath("$.title", contains("Ensure this field has no more than 255 characters.")));
        }

        @Test
        void requiresAuthentication() throws Exception {
            api.perform(post(LIST_URL).contentType(MediaType.APPLICATION_JSON).content("{\"title\": \"New {{Name}}\"}"))
                    .andExpect(status().isUnauthorized());
        }
    }

    @Nested
    class Listing {

        @Test
        void listsOnlyTheUsersOwn{{Names}}() throws Exception {
            create{{Name}}(me, "Mine", "");
            create{{Name}}(other, "Not Yours", "");

            send(get(LIST_URL), me)
                    .andExpect(status().isOk())
                    .andExpect(jsonPath("$.count").value(1))
                    .andExpect(jsonPath("$.next").isEmpty())
                    .andExpect(jsonPath("$.previous").isEmpty())
                    .andExpect(jsonPath("$.results[*].title", contains("Mine")));
        }

        @Test
        void ordersNewestFirst() throws Exception {
            create{{Name}}(me, "First", "");
            create{{Name}}(me, "Second", "");

            send(get(LIST_URL), me).andExpect(jsonPath("$.results[*].title", contains("Second", "First")));
        }

        @Test
        void ordersByARequestedField() throws Exception {
            create{{Name}}(me, "Banana", "");
            create{{Name}}(me, "Apple", "");

            send(get(LIST_URL).param("ordering", "title"), me)
                    .andExpect(jsonPath("$.results[*].title", contains("Apple", "Banana")));
        }

        @Test
        void searchesTitleAndDescription() throws Exception {
            create{{Name}}(me, "Apples", "");
            create{{Name}}(me, "Pears", "Not apples at all");
            create{{Name}}(me, "Plums", "");

            send(get(LIST_URL).param("search", "apple"), me)
                    .andExpect(jsonPath("$.results[*].title", containsInAnyOrder("Apples", "Pears")));
        }

        @Test
        void pagesTwentyAtATime() throws Exception {
            for (int i = 0; i < 21; i++) {
                create{{Name}}(me, "{{Name}} " + i, "");
            }

            send(get(LIST_URL), me)
                    .andExpect(jsonPath("$.count").value(21))
                    .andExpect(jsonPath("$.next").value("http://localhost/api/{{snakes}}/?page=2"))
                    .andExpect(jsonPath("$.previous").isEmpty());
            send(get(LIST_URL).param("page", "2"), me)
                    .andExpect(jsonPath("$.results.length()").value(1))
                    .andExpect(jsonPath("$.next").isEmpty())
                    .andExpect(jsonPath("$.previous").value("http://localhost/api/{{snakes}}/"));
        }

        @Test
        void requiresAuthentication() throws Exception {
            api.perform(get(LIST_URL)).andExpect(status().isUnauthorized());
        }
    }

    @Nested
