import { beforeEach, describe, expect, it } from 'vitest'
import type { User } from '@prisma/client'
import { prisma } from '../../../db/client.js'
import { api, authHeader, createUser } from '../../../__tests__/test-utils.js'

const LIST_URL = '/api/{{snakes}}/'
const detailUrl = (id: number | string) => `/api/{{snakes}}/${id}/`

let user: User
let auth: [string, string]

beforeEach(async () => {
  user = await createUser({ email: 'owner@example.com' })
  auth = await authHeader(user.id)
})

function create{{Name}}(owner: User, title = 'Test {{Name}}') {
  return prisma.{{name}}.create({
    data: { title, description: 'A test {{name}}.', created_by_id: owner.id },
  })
}

describe('POST /api/{{snakes}}/', () => {
  it('creates a {{name}} owned by the current user', async () => {
    const response = await api()
      .post(LIST_URL)
      .set(...auth)
      .send({ title: 'New {{Name}}', description: 'Created in a test.' })

    expect(response.status).toBe(201)
    expect(response.body.title).toBe('New {{Name}}')
    expect(response.body.created_by).toBe(user.id)
    expect(response.body.created_by_email).toBe(user.email)
  })

  it('requires a title', async () => {
    const response = await api().post(LIST_URL).set(...auth).send({ description: 'No title.' })

    expect(response.status).toBe(400)
    expect(response.body.title).toBeDefined()
  })

  it('requires authentication', async () => {
    const response = await api().post(LIST_URL).send({ title: 'New {{Name}}' })

    expect(response.status).toBe(401)
  })
})

describe('GET /api/{{snakes}}/', () => {
  it('returns the DRF page envelope', async () => {
    await create{{Name}}(user)

    const response = await api().get(LIST_URL).set(...auth)

    expect(response.status).toBe(200)
    expect(Object.keys(response.body).sort()).toEqual([
      'count',
      'next',
      'previous',
      'results',
    ])
    expect(response.body.count).toBe(1)
    expect(response.body.results).toHaveLength(1)
  })

  it('hides {{snakes}} owned by other users', async () => {
    const other = await createUser({ email: 'other@example.com' })
    await create{{Name}}(other, 'Not Yours')

    const response = await api().get(LIST_URL).set(...auth)

    expect(response.body.results).toEqual([])
  })

  it('filters by search across title and description', async () => {
    await create{{Name}}(user, 'Findable')
    await create{{Name}}(user, 'Hidden')

    const response = await api().get(`${LIST_URL}?search=Findable`).set(...auth)

    expect(response.body.count).toBe(1)
    expect(response.body.results[0].title).toBe('Findable')
  })

  it('orders newest first by default', async () => {
    await create{{Name}}(user, 'First')
    await create{{Name}}(user, 'Second')

    const response = await api().get(LIST_URL).set(...auth)

    expect(response.body.results.map((r: { title: string }) => r.title)).toEqual([
      'Second',
      'First',
    ])
  })

  it('accepts an explicit ordering', async () => {
    await create{{Name}}(user, 'Beta')
    await create{{Name}}(user, 'Alpha')

    const response = await api().get(`${LIST_URL}?ordering=title`).set(...auth)

    expect(response.body.results.map((r: { title: string }) => r.title)).toEqual([
      'Alpha',
      'Beta',
    ])
  })

  it('requires authentication', async () => {
    expect((await api().get(LIST_URL)).status).toBe(401)
  })
})

describe('GET /api/{{snakes}}/:id/', () => {
  it('returns a single {{name}}', async () => {
    const record = await create{{Name}}(user)

    const response = await api().get(detailUrl(record.id)).set(...auth)

    expect(response.status).toBe(200)
    expect(response.body.title).toBe(record.title)
  })

  it('404s for another user\'s {{name}}', async () => {
    const other = await createUser({ email: 'other@example.com' })
    const theirs = await create{{Name}}(other, 'Not Yours')

    const response = await api().get(detailUrl(theirs.id)).set(...auth)

    expect(response.status).toBe(404)
    expect(response.body).toEqual({ detail: 'Not found.' })
  })

  it('404s for a non-numeric id', async () => {
    expect((await api().get(detailUrl('abc')).set(...auth)).status).toBe(404)
  })
})

describe('PATCH /api/{{snakes}}/:id/', () => {
  it('updates the title', async () => {
    const record = await create{{Name}}(user)

    const response = await api()
      .patch(detailUrl(record.id))
      .set(...auth)
      .send({ title: 'Renamed' })

    expect(response.status).toBe(200)
    expect(response.body.title).toBe('Renamed')
  })

  it('cannot update another user\'s {{name}}', async () => {
    const other = await createUser({ email: 'other@example.com' })
    const theirs = await create{{Name}}(other, 'Not Yours')

    const response = await api()
      .patch(detailUrl(theirs.id))
      .set(...auth)
      .send({ title: 'Renamed' })

    expect(response.status).toBe(404)
    const unchanged = await prisma.{{name}}.findUnique({ where: { id: theirs.id } })
    expect(unchanged?.title).toBe('Not Yours')
  })
})

describe('DELETE /api/{{snakes}}/:id/', () => {
  it('deletes the {{name}}', async () => {
    const record = await create{{Name}}(user)

    const response = await api().delete(detailUrl(record.id)).set(...auth)

    expect(response.status).toBe(204)
    expect(await prisma.{{name}}.findUnique({ where: { id: record.id } })).toBeNull()
  })

  it('cannot delete another user\'s {{name}}', async () => {
    const other = await createUser({ email: 'other@example.com' })
    const theirs = await create{{Name}}(other, 'Not Yours')

    const response = await api().delete(detailUrl(theirs.id)).set(...auth)

    expect(response.status).toBe(404)
    expect(await prisma.{{name}}.findUnique({ where: { id: theirs.id } })).not.toBeNull()
  })
})
