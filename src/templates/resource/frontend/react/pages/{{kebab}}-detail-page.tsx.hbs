import { useState } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { Button, Card, HStack, Skeleton, SkeletonText, Stack, Text } from '@chakra-ui/react'
import { useGet{{Name}}, useUpdate{{Name}}, useDelete{{Name}} } from '@/api/hooks/{{kebabs}}'
import { Path } from '@/router/paths'
import { PageHeader } from '@/shared/components/page-header'
import { StatusAlert } from '@/shared/components/status-alert'
import { formatDateTime } from '@/shared/utils/format-date'
import { {{Name}}FormDialog } from './components/{{kebab}}-form-dialog'
import type { {{Name}}FormData } from './schemas'

export default function {{Name}}DetailPage() {
  const { id = '' } = useParams<{ id: string }>()
  const navigate = useNavigate()
  const [editing, setEditing] = useState(false)

  const { data: {{name}}, isLoading, errorMessage } = useGet{{Name}}(id)
  const update{{Name}} = useUpdate{{Name}}(id)
  const delete{{Name}} = useDelete{{Name}}()

  if (isLoading) {
    return (
      <Stack gap="6" role="status" aria-label="Loading {{label}}">
        <Skeleton h="10" w="64" />
        <SkeletonText noOfLines={3} />
      </Stack>
    )
  }

  if (errorMessage) {
    return <StatusAlert message={errorMessage} />
  }

  if (!{{name}}) {
    return <Text color="fg.muted">{{Label}} not found.</Text>
  }

  const openEditor = () => {
    update{{Name}}.reset()
    setEditing(true)
  }

  const handleSave = (body: {{Name}}FormData) => {
    update{{Name}}.mutate({ path: { id }, body }, { onSuccess: () => setEditing(false) })
  }

  const handleDelete = () => {
    if (!window.confirm('Are you sure you want to delete this {{label}}?')) return
    delete{{Name}}.mutate({ path: { id } }, { onSuccess: () => navigate(Path.{{Names}}) })
  }

  return (
    <Stack gap="8">
      {delete{{Name}}.errorMessage && <StatusAlert message={delete{{Name}}.errorMessage} />}

      <PageHeader
        title={ {{name}}.title}
        actions={
          <HStack gap="2">
            <Button variant="outline" size="sm" onClick={openEditor}>
              Edit
            </Button>
            <Button
              variant="outline"
              size="sm"
              colorPalette="red"
              onClick={handleDelete}
              loading={delete{{Name}}.isPending}
              loadingText="Deleting..."
            >
              Delete
            </Button>
          </HStack>
        }
      />

      <Card.Root variant="outline">
        <Card.Body gap="4">
          <Text whiteSpace="pre-wrap">
            { {{name}}.description || 'No description.'}
          </Text>
          <Text textStyle="sm" color="fg.muted">
            Created {formatDateTime({{name}}.created_at)}
          </Text>
        </Card.Body>
      </Card.Root>

      <{{Name}}FormDialog
        title="Edit {{label}}"
        open={editing}
        onOpenChange={setEditing}
        defaultValues=\{{ title: {{name}}.title, description: {{name}}.description }}
        onSubmit={handleSave}
        isSubmitting={update{{Name}}.isPending}
        errorMessage={update{{Name}}.errorMessage}
        fieldErrors={update{{Name}}.fieldErrors}
      />
    </Stack>
  )
}
