import { screen, renderWithProviders } from '@/__tests__/test-utils'
import type { {{Name}} } from '@/api/generated'
import { {{Name}}List } from '../{{kebab}}-list'

// Only the fields the component reads. The id is a number or a UUID string
// depending on the backend, so the fixtures are cast rather than typed in full.
const items = [
  { id: '1', title: 'First {{Name}}', description: '', created_at: '2024-01-15T10:00:00Z' },
  { id: '2', title: 'Second {{Name}}', description: 'With a description.', created_at: '2024-02-20T10:00:00Z' },
] as unknown as {{Name}}[]

describe('{{Name}}List', () => {
  it('shows loading skeletons while loading', () => {
    renderWithProviders(<{{Name}}List {{names}}={[]} isLoading />)

    const loading = screen.getByRole('status', { name: /loading {{labels}}/i })
    expect(loading.children).toHaveLength(6)
  })

  it('shows the empty state when there are no {{names}}', () => {
    renderWithProviders(<{{Name}}List {{names}}={[]} />)

    expect(screen.getByText(/no {{labels}} yet/i)).toBeInTheDocument()
  })

  it('renders a card per {{name}}', () => {
    renderWithProviders(<{{Name}}List {{names}}={items} />)

    expect(screen.getByText('First {{Name}}')).toBeInTheDocument()
    expect(screen.getByText('Second {{Name}}')).toBeInTheDocument()
  })

  it('prefers the list over the empty state when both could apply', () => {
    renderWithProviders(<{{Name}}List {{names}}={items} />)

    expect(screen.queryByText(/no {{labels}} yet/i)).not.toBeInTheDocument()
  })
})
