import { screen, renderWithProviders } from '@/__tests__/test-utils'
import type { {{Name}} } from '@/api/generated'
import { {{Name}}Card } from '../{{kebab}}-card'

// Only the fields the component reads. The id is a number or a UUID string
// depending on the backend, so the fixtures are cast rather than typed in full.
const item = {
  id: '42',
  title: 'A {{Name}}',
  description: 'Something descriptive.',
  created_at: '2024-01-15T10:00:00Z',
} as unknown as {{Name}}

describe('{{Name}}Card', () => {
  it('renders the title', () => {
    renderWithProviders(<{{Name}}Card {{name}}={item} />)

    expect(screen.getByText('A {{Name}}')).toBeInTheDocument()
  })

  it('renders the description when present', () => {
    renderWithProviders(<{{Name}}Card {{name}}={item} />)

    expect(screen.getByText('Something descriptive.')).toBeInTheDocument()
  })

  it('omits the description when empty', () => {
    renderWithProviders(<{{Name}}Card {{name}}=\{{ ...item, description: '' }} />)

    expect(screen.queryByText('Something descriptive.')).not.toBeInTheDocument()
  })

  it('links to the detail page', () => {
    renderWithProviders(<{{Name}}Card {{name}}={item} />)

    expect(screen.getByRole('link')).toHaveAttribute('href', '/{{kebabs}}/42')
  })
})
